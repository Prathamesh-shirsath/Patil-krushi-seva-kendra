{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ]
}